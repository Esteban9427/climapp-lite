# Set de evaluación de reportes (TASK-021). Copiar estas claves al .env de la raíz.
# Tabla de eventos de nivel de la entrega 2026-11-01, relativa a DATA_DIR.
# Su nombre real lleva el de la estación: va solo en .env (ADR-004 §8)
EVAL_EVENTS_FILE=raw/entrega_2026-11-01/eventos_nivel.csv
# Día seco: subida máxima en 24 h por debajo de esto (SUPUESTO, TASK-021)
EVAL_DRY_RISE_M=0.05
# Subida que afirma un reporte exagerado
EVAL_CLAIMED_RISE_M=5
EVAL_SEED=21
# Posiciones de ADR-004 y lugares públicos de OpenStreetMap sobre el río (nunca estaciones)
EVAL_SECTORS=["alta","media-alta","media","piedemonte","La Vorágine"]
# Relativa a la raíz del repositorio
EVAL_OUTPUT=eval-harness/spec_reportes.jsonl
EVAL_N_COHERENTE=25
EVAL_N_EXAGERADO=10
EVAL_N_FALSO=10
EVAL_N_DIFICIL=5
