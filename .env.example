# Copiar a .env (no versionado) y completar. Sin secretos aquí.

# Meta Model API (ADR-002)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_EFFORT_STRUCTURE=low
MUSE_EFFORT_JUDGE=medium
MUSE_MAX_TOKENS=2000
VERIFY_MAX_ATTEMPTS=3

# Datos (ADR-004): fuera de git
DATA_DIR=
EARTHDATA_TOKEN=

# Pronóstico (ADR-001). Valores marcados SUPUESTO en el PRD
# principal | plan_b_earthdata | plan_b_datos (ADR-001 §5, ADR-004 §5)
DATA_PLAN=plan_b_earthdata
FORECAST_THRESHOLD_MM=20
ACCUM3_THRESHOLD_MM=100
TARGET_RULE=basin_mean
STATION_GROUP_MIN_R=0.8

# Producto
OFFICIAL_CHANNELS_URL=
DEMO_FALLBACK=0
SCOPE_FREEZE_DATE=2026-11-02

# Limpieza de estaciones (ADR-004 §2). Umbrales SUPUESTO
LOCAL_TIMEZONE=America/Bogota
COUNTER_SENSORS=["P","PRECIP"]
MAX_STEP_MM=40
# SP-12 (pendiente de JM): salto aislado que se marca suspect sin borrarse
SUSPECT_STEP_MM=30
SUSPECT_QUIET_MIN=60
# Lluvia máxima tolerada en cada ventana de calma (0 = regla literal de SP-12)
SUSPECT_QUIET_MAX_MM=0

# Tabla diaria de estaciones (ADR-004 §2 y §4). Rutas relativas a DATA_DIR
# Exportaciones en orden de preferencia: ante lecturas repetidas gana la primera
STATION_EXPORTS=["raw/entrega_2026-10-29/Data/EXPORT_PANCE_RAWDATA.xls","raw/entrega_2026-10-29/Data/ExportJMN_Pance.csv"]
# Correspondencia nombre en la exportación → EST-A..EST-D; vive fuera de git (D-03)
STATION_MAP_FILE=station_map.json
DAILY_STATIONS_FILE=derived/daily_stations.csv
# Día válido con >= MIN_READINGS de 144 lecturas (SUPUESTO, SP-8)
MIN_READINGS=100
