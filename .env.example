# Copiar a .env (no versionado) y completar. Sin secretos aquí.

# Meta Model API (ADR-002)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_EFFORT_STRUCTURE=low
MUSE_EFFORT_JUDGE=medium
MUSE_EFFORT_EXPLAIN=low
MUSE_MAX_TOKENS=2000
VERIFY_MAX_ATTEMPTS=3
# Tiempo máximo por llamada a Muse, en segundos (SUPUESTO)
MUSE_TIMEOUT_S=60
# Respuestas grabadas para DEMO_FALLBACK=1 (ADR-002 §5). VERSIONADO, relativa a la raíz del repo
MUSE_FALLBACK_FILE=config/muse_fallback.json
# Resumen de la evaluación de reportes para GET /evaluation (TASK-021/036).
# VERSIONADO, relativa a la raíz del repo; si falta, report_verification es null
REPORT_EVAL_FILE=eval-harness/reports/report_eval.json

# Datos (ADR-004): fuera de git
DATA_DIR=
EARTHDATA_TOKEN=

# Pronóstico (ADR-001). Valores marcados SUPUESTO en el PRD
# principal | plan_b_earthdata | plan_b_datos (ADR-001 §5, ADR-004 §5)
DATA_PLAN=plan_b_earthdata
FORECAST_THRESHOLD_MM=20
ACCUM3_THRESHOLD_MM=100
TARGET_RULE=basin_mean
STATION_GROUP_MIN_R=0.8
# Grupos de estaciones (TASK-002, ADR-002 §4): días comunes mínimos para estimar r (SUPUESTO)
STATION_GROUP_MIN_OVERLAP_DAYS=365
# Confianza de los reportes (ADR-002 §4, PRD SP-15): pesos del equipo (2026-10-31), fijados antes
# de evaluar la demo y aceptados por JM para v1 (2026-11-01); su calibración es TASK-021
CONFIDENCE_WEIGHT_STATION=1.0
CONFIDENCE_WEIGHT_SATELLITE=0.5
CONFIDENCE_WEIGHT_FORECAST=0.25
# Subida de nivel del río en reportes de creciente (TASK-039): peso (aceptado por JM para v1) y
# subida mínima en 24 h en m (SUPUESTO abierto, PRD SP-17), fijados antes de evaluar la demo
CONFIDENCE_WEIGHT_LEVEL=1.0
LEVEL_RISE_THRESHOLD_M=0.30
# Etiqueta visible de un reporte verificado según su confianza (SUPUESTO, ADR-002 §4):
# ≥ AGREEMENT_HIGH "Coincide con los datos"; ≥ AGREEMENT_LOW "Coincidencia parcial"; si no, "No coincide"
AGREEMENT_HIGH=0.7
AGREEMENT_LOW=0.3
# Día (o ventana) con lluvia: >= 1 mm ([OMM] OMM-N° 1203 pág. PDF 14, PRD SP-2)
RAIN_DAY_MM=1

# Producto
# Reportes ciudadanos (TASK-016). Rutas relativas a DATA_DIR (fuera de git)
# Polígono de la cuenca en GeoJSON (Polygon o MultiPolygon); sin él, POST /reports responde 503
BASIN_POLYGON_FILE=basin.geojson
REPORTS_DB_FILE=climapp.db
# Mismo texto enviado otra vez en menos de estos minutos: es duplicado y no se guarda
DUPLICATE_WINDOW_MIN=10
PHOTOS_DIR=photos
# Tamaño máximo de foto: 5 MB (data-model ReportIn)
MAX_PHOTO_BYTES=5242880
# Decimales de las coordenadas publicadas (3 ≈ 100 m, privacidad)
PUBLIC_COORD_DECIMALS=3
# Mapa (TASK-018): teselas de OpenStreetMap con la atribución que exige la ODbL
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
OFFICIAL_CHANNELS_URL=
# Segundo canal oficial, citado en el aviso: pronósticos y alertas del IDEAM
IDEAM_ALERTS_URL=https://www.ideam.gov.co/nuestra-entidad/servicio-de-pronosticos-y-alertas
DEMO_FALLBACK=0
# Fecha de emisión de la reproducción de la demo (evento del 2026-09-30, PRD SP-5:
# objetivo 2026-10-02); vacía = sin enlace. E1 (2024-12-31) queda como caso de falsa alarma
DEMO_REPLAY_DATE=2026-10-01
# Hora de recepción que ve el modelo en modo demo: hace reproducibles los pedidos grabados
# (la tarde del 2026-10-02, cuando el nivel subió en la parte media)
DEMO_REPORT_TIME=2026-10-02T16:30:00-05:00
# Ubicación de los botones de ejemplo: punto a mitad del cauce del río Pance (parte media),
# sobre la geometría de los 15 tramos waterway=river "Río Pance" de OpenStreetMap (Overpass,
# consultado el 2026-11-01; © OpenStreetMap contributors, ODbL). No es una estación
DEMO_EXAMPLE_LAT=3.346
DEMO_EXAMPLE_LON=-76.588
# Textos de los reportes de ejemplo de la demo (VERSIONADO, relativa a la raíz del repo)
DEMO_REPORTS_FILE=config/demo_reports.json
SCOPE_FREEZE_DATE=2026-11-02

# Limpieza de estaciones (ADR-004 §2). Umbrales SUPUESTO
LOCAL_TIMEZONE=America/Bogota
COUNTER_SENSORS=["P","PRECIP"]
MAX_STEP_MM=40
# Paso entre lecturas separadas por más de MAX_GAP_MIN: no se atribuye como lluvia (SUPUESTO)
MAX_GAP_MIN=20
# SP-12 [JM 2026-10-30]: salto aislado tras lecturas regulares = suspect; no suma al total diario
SUSPECT_STEP_MM=30
SUSPECT_QUIET_MIN=60
# Lluvia máxima tolerada en cada ventana de calma [JM 2026-10-30]
SUSPECT_QUIET_MAX_MM=2

# Tabla diaria de estaciones (ADR-004 §2 y §4). Rutas relativas a DATA_DIR
# Exportaciones en orden de preferencia: ante lecturas repetidas gana la primera
# Ejemplo genérico: las rutas reales de cada entrega van solo en .env
STATION_EXPORTS=["raw/<entrega>/estaciones.xls","raw/<entrega>/estaciones.csv"]
# Correspondencia nombre en la exportación → EST-A..EST-D; vive fuera de git (ADR-004;
# D-03 se cerró el 2026-10-31 y los nombres siguen sin publicarse)
STATION_MAP_FILE=station_map.json
DAILY_STATIONS_FILE=derived/daily_stations.csv
# Nivel del río en la estación de la parte media (TASK-038), relativo a DATA_DIR.
# El nombre real del archivo va solo en .env (lleva el nombre de la estación, ADR-004)
LEVEL_EXPORTS=["raw/entrega_2026-11-01/nivel_parte_media.xlsx"]
LEVEL_SENSOR=NIVEL
LEVEL_DAILY_FILE=derived/level_daily.csv
# Serie de nivel que usa la evidencia de crecientes (TASK-039)
LEVEL_SERIES_ID=EST-A
# IMERG Early diario (TASK-009b): una celda por OPeNDAP de GES DISC con EARTHDATA_TOKEN.
# Solo evidencia satelital de los reportes; no entra al modelo (congelado)
IMERG_OPENDAP_URL=https://gpm1.gesdisc.eosdis.nasa.gov/opendap/GPM_L3/GPM_3IMERGDE.07
# Sufijos de versión del archivo diario, en orden de preferencia
IMERG_FILE_VERSIONS=["V07C","V07B"]
IMERG_GRID_DEG=0.1
# Días anteriores a hoy que trae climapp-imerg (los ya guardados no se vuelven a pedir)
IMERG_DAYS=45
IMERG_EARLY_FILE=derived/imerg_early.csv
IMERG_RETRIES=3
IMERG_BACKOFF_S=2
IMERG_TIMEOUT_S=60
# Pico de una sola lectura: salta y regresa más que esto (m) respecto de sus dos vecinas;
# se descarta antes de la serie diaria (SUPUESTO; SP-17 para JM)
NIVEL_MAX_STEP_M=1.0
# Periodos de falla conocidos (SP-13): sus días quedan inválidos. Archivo VERSIONADO,
# ruta relativa a la raíz del repositorio (no a DATA_DIR); solo identificadores EST-x
KNOWN_OUTAGES_FILE=config/known_outages.json
# Día válido con >= MIN_READINGS de 144 lecturas (SUPUESTO, SP-8)
MIN_READINGS=100

# Líneas base y evaluación (ADR-001 §8 y §10)
CLIMATOLOGY_WINDOW_DAYS=15
RELIABILITY_BINS=10

# Variables y random forest (ADR-001 §1, §3 y §9). Partición temporal: SUPUESTO
# Calibración isotónica fuera de muestra por años: de CALIBRATION_START a VALID_END
CHIRPS_FILES=["raw/entrega_2026-10-29/Data/CHIRPS/1. P_D_1981_1992-Pance.xlsx","raw/entrega_2026-10-29/Data/CHIRPS/2. P_D_1993_2003-Pance.xlsx","raw/entrega_2026-10-29/Data/CHIRPS/3. P_D_2004_2013-Pance.xlsx","raw/entrega_2026-10-29/Data/CHIRPS/4. P_D_2014_2026-Pance.xlsx"]
TRAIN_START=2013-10-01
CALIBRATION_START=2020-01-01
VALID_END=2022-12-31
TEST_END=2026-10-31
RF_N_ESTIMATORS=500
RF_MIN_SAMPLES_LEAF=5
RF_RANDOM_STATE=42
EVALUATION_FILE=derived/evaluation.json
FORECASTS_FILE=derived/forecasts.json
# Grupos de estaciones con r >= STATION_GROUP_MIN_R entre TRAIN_START y TEST_END (toda la tabla). Relativa a DATA_DIR
STATION_GROUPS_FILE=derived/station_groups.json
