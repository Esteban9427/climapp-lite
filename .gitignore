# Datos: nunca se versionan
/data/
*.xls
*.xlsx
*.csv
*.parquet
*.nc
*.nc4
*.h5

# Secretos y términos que no se publican (DoD §7)
.env
.forbidden-terms

# Excepción: fixtures pequeños de tests
!tests/fixtures/**

# Entorno y cachés de herramientas
.venv/
__pycache__/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
